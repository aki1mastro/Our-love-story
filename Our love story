<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сабина и Аким | Наша История</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="header">
        <div class="header-content">
            <h1>Сабина & Аким</h1>
            <p>История нашей любви</p>
            <div class="counter-box">
                <span id="days-count">0</span>
                <span class="label">Дней вместе</span>
            </div>
        </div>
    </header>

    <section class="timeline" id="timeline-container">
        </section>

    <button id="add-btn" class="add-btn">+</button>

    <div id="add-modal" class="modal">
        <div class="modal-content">
            <span class="close-btn" id="close-modal">&times;</span>
            <h2 style="margin-top: 0; color: #2d3436;">Новое воспоминание</h2>
            
            <input type="date" id="new-date" required>
            <input type="text" id="new-title" placeholder="Заголовок (например: Наша поездка)" required>
            <textarea id="new-text" placeholder="История..." rows="4" required></textarea>
            
            <label style="font-size: 0.9rem; color: #636e72; margin-top: 10px; display: block;">Прикрепить фото (необязательно):</label>
            <input type="file" id="new-image" accept="image/*" style="padding: 10px 5px; width: 100%;">

            <input type="password" id="new-password" placeholder="Секретный пароль" required>
            
            <button id="submit-memory" class="save-btn">Сохранить</button>
            <p id="status-msg" style="text-align: center; color: #ff4b72; font-size: 0.9rem; margin-top: 10px; font-weight: bold;"></p>
        </div>
    </div>

    <script src="memories.js"></script> 

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
        // Импортируем Storage для картинок
        import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-storage.js";

        // Твой конфиг
        const firebaseConfig = {
            apiKey: "AIzaSyBi-chMoOpwQsTq9MWqxJ_qXuNDyMM5NpY",
            authDomain: "love-story-2fe60.firebaseapp.com",
            projectId: "love-story-2fe60",
            storageBucket: "love-story-2fe60.firebasestorage.app",
            messagingSenderId: "938943940362",
            appId: "1:938943940362:web:f401a16b3cf322ccaa1cf3"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const storage = getStorage(app); 

        const SECRET_PASSWORD = "1404"; 
        const container = document.getElementById('timeline-container');

        function parseDate(dateStr) {
            if (!dateStr || !dateStr.includes('.')) return new Date();
            const [day, month, year] = dateStr.split('.');
            return new Date(`${year}-${month}-${day}`);
        }

        function renderTimeline(allData) {
            container.innerHTML = ""; 
            allData.sort((a, b) => parseDate(a.date) - parseDate(b.date));

            allData.forEach((mem, index) => {
                const side = index % 2 === 0 ? 'left' : 'right';
                let contentHtml = '';

                if (mem.type === 'photo') {
                    contentHtml = `
                        <p class="description">${mem.text}</p>
                        <div class="img-container">
                            <img src="${mem.image}" alt="${mem.title}" onerror="this.style.display='none'">
                        </div>
                    `;
                } else if (mem.type === 'event') {
                    contentHtml = `<p class="description event-text">${mem.text}</p>`;
                } else {
                    contentHtml = `<p class="chat-quote"><b>${mem.sender || 'Мы'}:</b> ${mem.text}</p>`;
                }

                const html = `
                    <div class="memory-container ${side}">
                        <div class="content">
                            <div class="date">${mem.date}</div>
                            <h2>${mem.title}</h2>
                            ${contentHtml}
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
            checkScroll();
        }

        async function loadAllMemories() {
            let combinedMemories = [];
            if (typeof memories !== 'undefined') combinedMemories = [...memories];

            try {
                const querySnapshot = await getDocs(collection(db, "user_memories"));
                querySnapshot.forEach((doc) => {
                    combinedMemories.push(doc.data());
                });
            } catch (error) {
                console.error("Ошибка базы данных:", error);
            }

            renderTimeline(combinedMemories);
        }

        loadAllMemories();

        // Форма
        const modal = document.getElementById("add-modal");
        const btn = document.getElementById("add-btn");
        const closeBtn = document.getElementById("close-modal");

        btn.onclick = () => { modal.style.display = "flex"; }
        closeBtn.onclick = () => { modal.style.display = "none"; }
        window.onclick = (event) => { if (event.target == modal) modal.style.display = "none"; }

        // Кнопка сохранения
        document.getElementById("submit-memory").addEventListener("click", async () => {
            const dateVal = document.getElementById("new-date").value;
            const titleVal = document.getElementById("new-title").value;
            const textVal = document.getElementById("new-text").value;
            const passVal = document.getElementById("new-password").value;
            const fileInput = document.getElementById("new-image");
            const statusMsg = document.getElementById("status-msg");

            if (!dateVal || !titleVal || !textVal) {
                statusMsg.innerText = "Заполните текстовые поля!";
                return;
            }

            if (passVal !== SECRET_PASSWORD) {
                statusMsg.innerText = "Неверный пароль!";
                return;
            }

            const [year, month, day] = dateVal.split('-');
            const formattedDate = `${day}.${month}.${year}`;
            
            let imageUrl = "";
            let memoryType = "event"; 

            try {
                // Если выбрано фото - загружаем в Storage
                if (fileInput.files.length > 0) {
                    statusMsg.innerText = "Грузим фото в облако... ⏳";
                    const file = fileInput.files[0];
                    const storageReference = ref(storage, 'memories_photos/' + Date.now() + '_' + file.name);
                    
                    await uploadBytes(storageReference, file);
                    imageUrl = await getDownloadURL(storageReference);
                    memoryType = "photo"; 
                }

                statusMsg.innerText = "Сохраняем историю... ⏳";

                // Записываем в Firestore
                await addDoc(collection(db, "user_memories"), {
                    date: formattedDate,
                    title: titleVal,
                    text: textVal,
                    type: memoryType,
                    image: imageUrl
                });
                
                statusMsg.innerText = "Готово! ❤️";
                setTimeout(() => {
                    modal.style.display = "none";
                    document.getElementById("new-title").value = '';
                    document.getElementById("new-text").value = '';
                    document.getElementById("new-password").value = '';
                    document.getElementById("new-image").value = '';
                    statusMsg.innerText = '';
                    loadAllMemories(); 
                }, 1500);

            } catch (e) {
                statusMsg.innerText = "Ошибка: " + e.message;
                console.error(e);
            }
        });

        // Анимация
        function checkScroll() {
            const items = document.querySelectorAll('.memory-container');
            const triggerBottom = window.innerHeight / 5 * 4;
            items.forEach(item => {
                const itemTop = item.getBoundingClientRect().top;
                if(itemTop < triggerBottom) item.classList.add('show');
            });
        }
        window.addEventListener('scroll', checkScroll);

        const startDate = new Date('2025-04-14');
        const countElement = document.getElementById('days-count');
        function updateCounter() {
            const now = new Date();
            const diff = now - startDate;
            countElement.innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
        }
        updateCounter();
    </script>
</body>
</html>
const memories = [];
/* --- ПОДКЛЮЧЕНИЕ ШРИФТОВ --- */
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;800&family=Caveat:wght@600&display=swap');

/* --- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ --- */
:root {
    --primary: #ff4b72;   /* Нежно-малиновый */
    --secondary: #ff7e67; /* Персиковый */
    --text-dark: #2d3436;
    --text-light: #636e72;
    --card-bg: rgba(255, 255, 255, 0.75); /* Полупрозрачный белый */
}

body {
    /* Нежный теплый фон вместо скучного серого */
    background: linear-gradient(135deg, #fff0f3 0%, #fdfbfb 100%);
    background-attachment: fixed;
    font-family: 'Montserrat', sans-serif;
    margin: 0;
    color: var(--text-dark);
    overflow-x: hidden;
}

/* Красивый скроллбар */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }

/* --- ШАПКА --- */
.header {
    height: 100vh;
    background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('img/main_bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
}
.header h1 { 
    font-size: 4rem; 
    margin-bottom: 10px; 
    font-weight: 800; 
    text-shadow: 0 4px 15px rgba(0,0,0,0.3);
}
.header p { 
    font-size: 1.2rem; 
    letter-spacing: 3px; 
    text-transform: uppercase; 
    opacity: 0.9;
}

/* Счетчик дней */
.counter-box {
    margin-top: 30px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 20px 50px;
    border-radius: 30px;
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
}
#days-count { font-size: 3.5rem; font-weight: 800; display: block; line-height: 1; }
.label { font-size: 0.9rem; font-weight: 500; letter-spacing: 1px; }

/* --- ЛЕНТА ВРЕМЕНИ (TIMELINE) --- */
.timeline { 
    position: relative; 
    max-width: 1000px; 
    margin: 80px auto; 
    padding: 0 20px 100px 20px; 
}

/* Линия по центру */
.timeline::after {
    content: ''; 
    position: absolute; 
    width: 4px; 
    background: linear-gradient(to bottom, var(--primary), var(--secondary));
    top: 0; bottom: 0; left: 50%; 
    margin-left: -2px; 
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(255, 75, 114, 0.3);
}

.memory-container {
    padding: 10px 40px; 
    position: relative; 
    width: 50%; 
    box-sizing: border-box;
    opacity: 0; 
    transform: translateY(40px); 
    transition: all 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.memory-container.show { opacity: 1; transform: translateY(0); }

.left { left: 0; text-align: right; }
.right { left: 50%; text-align: left; }

/* Пульсирующие сердечки на линии */
@keyframes heartbeat {
    0% { transform: scale(1); }
    15% { transform: scale(1.15); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15); }
    60% { transform: scale(1); }
}

.memory-container::after {
    content: '❤'; 
    position: absolute; 
    width: 34px; height: 34px;
    background-color: white; 
    border: 3px solid var(--primary);
    color: var(--primary);
    top: 25px; 
    border-radius: 50%; 
    z-index: 10;
    display: flex; justify-content: center; align-items: center; 
    font-size: 16px;
    box-shadow: 0 0 15px rgba(255, 75, 114, 0.4);
    animation: heartbeat 2.5s infinite;
}
.left::after { right: -20px; }
.right::after { left: -20px; }

/* --- КАРТОЧКА С КОНТЕНТОМ (GLASSMORPHISM) --- */
.content {
    padding: 30px; 
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 24px;
    box-shadow: 0 15px 35px rgba(255, 75, 114, 0.08); 
    position: relative;
    max-width: 420px; 
    transition: transform 0.3s, box-shadow 0.3s;
}
.left .content { margin-left: auto; }
.right .content { margin-right: auto; }

.content:hover { 
    transform: translateY(-5px); 
    box-shadow: 0 20px 40px rgba(255, 75, 114, 0.15);
}

/* Рукописная дата */
.date { 
    font-family: 'Caveat', cursive;
    color: var(--primary); 
    font-size: 1.6rem; 
    margin-bottom: 5px; 
}
h2 { margin: 0 0 15px 0; font-size: 1.5rem; color: var(--text-dark); }

/* --- ДИЗАЙН ПЕРЕПИСКИ (КАК В МЕССЕНДЖЕРЕ) --- */
.chat-quote {
    background: white; 
    padding: 15px 20px; 
    border-radius: 20px;
    border-bottom-left-radius: 5px; /* Хвостик сообщения */
    margin: 15px 0 0 0; 
    color: var(--text-dark); 
    text-align: left;
    font-size: 0.95rem; 
    line-height: 1.5;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}
/* Для правой стороны делаем другой цвет и хвостик справа */
.right .chat-quote {
    background: #ffe3e8;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 5px;
}
.chat-quote b { color: var(--primary); font-weight: 600; display: block; margin-bottom: 5px; font-size: 0.85rem;}

/* --- ФОТОГРАФИИ --- */
.img-container {
    width: 100%; margin-top: 15px; border-radius: 15px; overflow: hidden;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}
.img-container img { width: 100%; height: auto; display: block; transition: transform 0.6s; }
.img-container:hover img { transform: scale(1.05); }

/* Тексты */
.description { font-size: 1rem; line-height: 1.6; color: var(--text-light); margin: 0; }
.event-text { 
    background: rgba(255, 126, 103, 0.1); 
    padding: 15px; 
    border-radius: 12px; 
    border-left: 4px solid var(--secondary); 
    color: var(--text-dark);
}

/* --- СТАТИСТИКА И ФУТЕР --- */
.stats { 
    background: white; 
    padding: 60px 20px; 
    text-align: center; 
    border-top: 1px solid rgba(0,0,0,0.05); 
}
.stats-grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; margin-top: 30px; }
.stat-item h3 { font-size: 3rem; color: var(--primary); margin: 0; font-weight: 800;}
.stat-item p { color: var(--text-light); font-weight: 500; margin-top: 5px;}

footer { 
    background: var(--text-dark); 
    color: white; 
    text-align: center; 
    padding: 30px 20px; 
    font-weight: 300;
}

/* --- КНОПКА ДОБАВЛЕНИЯ И ФОРМА FIREBASE --- */
.add-btn {
    position: fixed; bottom: 30px; right: 30px;
    width: 65px; height: 65px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white; border-radius: 50%; font-size: 35px; border: none;
    box-shadow: 0 10px 25px rgba(255, 75, 114, 0.4);
    cursor: pointer; z-index: 100; transition: transform 0.3s;
    display: flex; justify-content: center; align-items: center;
}
.add-btn:hover { transform: scale(1.1) rotate(90deg); }

.modal {
    display: none; position: fixed; z-index: 200; left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(45, 52, 54, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    justify-content: center; align-items: center;
}
.modal-content {
    background: white; padding: 40px 30px; border-radius: 24px;
    width: 90%; max-width: 400px; position: relative;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    animation: slideDown 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
@keyframes slideDown {
    from { transform: translateY(-30px) scale(0.95); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}
.close-btn {
    position: absolute; right: 20px; top: 15px;
    font-size: 28px; cursor: pointer; color: #b2bec3; transition: 0.2s;
}
.close-btn:hover { color: var(--primary); }

.modal-content input, .modal-content textarea {
    width: 100%; padding: 15px; margin: 10px 0;
    border: 1px solid #dfe6e9; border-radius: 12px;
    box-sizing: border-box; font-family: 'Montserrat', sans-serif;
    background: #fdfbfb; transition: 0.3s;
}
.modal-content input:focus, .modal-content textarea:focus {
    outline: none; border-color: var(--primary); background: white;
}
.modal-content button.save-btn {
    width: 100%; padding: 15px; margin-top: 15px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white; border: none; border-radius: 12px;
    font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: 0.3s;
}
.modal-content button.save-btn:hover { box-shadow: 0 8px 20px rgba(255, 75, 114, 0.3); transform: translateY(-2px); }

/* --- МОБИЛЬНАЯ ВЕРСИЯ --- */
@media screen and (max-width: 768px) {
    .timeline::after { left: 30px; }
    .memory-container { width: 100%; padding-left: 70px; padding-right: 20px; }
    .left, .right { left: 0; text-align: left; }
    .left::after, .right::after { left: 11px; }
    .header h1 { font-size: 2.8rem; }
    .left .content, .right .content { margin: 0; }
    .add-btn { bottom: 20px; right: 20px; width: 55px; height: 55px; font-size: 30px; }
}
